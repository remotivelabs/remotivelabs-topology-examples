*.auto.tfvars
*.backend.hcl

!terraform/cloud-server-template/
!terraform/cloud-server-template/**

# Per-server topology-user keys: ignore all but the committed sample.
ansible/servers/*
!ansible/servers/cloud-server-template.yaml
